// Prisma schema: the single source of truth for the database tables.
// `prisma migrate` reads this file and creates the tables in the SQLite file;
// `prisma generate` derives the TypeScript types from the same models.

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL, not SQLite.
//
// SQLite is a file on local disk. That is perfect for a single-process
// learning app and impossible in Kubernetes, for two independent reasons:
//
//   1. Pod filesystems are ephemeral. A pod restart — a deploy, an eviction,
//      a node drain, an OOM kill — discards the file and every row in it.
//   2. Replicas do not share a filesystem. With two app pods, each would open
//      its own copy of the file and they would silently disagree about the
//      state of the world.
//
// A network database solves both: one authoritative store, reachable by every
// pod over DNS, with its own lifecycle and its own persistent volume. That is
// what k8s/postgres-statefulset.yaml provisions.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Todo {
  id          String   @id @default(cuid())
  title       String
  description String?  // `?` = optional → `string | null` on the TypeScript side
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Index so the newest todos can be ordered quickly.
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Task Assignment feature (served over GraphQL, not tRPC).
//
// These two models are completely independent of Todo above. They exist so the
// project can demonstrate the same stack solved twice: Todo via tRPC, Task
// Assignment via GraphQL. They share one Prisma client and one SQLite file.
// ---------------------------------------------------------------------------

model User {
  id   String @id @default(cuid())
  name String
  age  Int

  // The "virtual" side of the one-to-one relation: it holds no column in the
  // database. Prisma derives it by looking for the Task row whose userId
  // points here. Optional (`?`) because a user may have no task yet.
  task Task?

  // --- Team & Activity feature ---
  // A user belongs to at most one team (the many side of a 1-N relation), and
  // writes many comments.
  team     Team?     @relation(fields: [teamId], references: [id])
  teamId   String?
  comments Comment[]

  @@index([teamId])
}

model Task {
  id          String @id @default(cuid())
  name        String
  description String
  type        String

  // The "owning" side: this model physically stores the foreign key column.
  user   User?   @relation(fields: [userId], references: [id])
  userId String? @unique
  // ^ @unique is what turns this into ONE-TO-ONE rather than one-to-many.
  //   Without it, many tasks could share a userId. With it, the database
  //   itself rejects a second task pointing at the same user — so the
  //   invariant survives even if application code has a bug.

  // --- Team & Activity feature ---
  // Contrast with `userId` above: NO @unique here, so many tasks can share one
  // teamId. Dropping that single keyword is the whole difference between a
  // 1-1 and a 1-N relation.
  team     Team?     @relation(fields: [teamId], references: [id])
  teamId   String?
  comments Comment[]

  // --- Voice message feature ---
  // Virtual side again: the foreign key lives on VoiceMessage.
  voiceMessage VoiceMessage?

  @@index([teamId])
}

// ---------------------------------------------------------------------------
// Team & Activity feature (GraphQL, third tab).
//
// Adds the relation shapes the earlier features lacked: 1-N (Team → users,
// Team → tasks) and a join-like child collection (Task → comments) that is
// what makes DataLoader worth implementing.
// ---------------------------------------------------------------------------

model Team {
  id   String @id @default(cuid())
  name String

  // Both are "virtual" sides again — the foreign keys live on User and Task.
  users User[]
  tasks Task[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  // Both relations are REQUIRED (no `?`): a comment with no task or no author
  // is meaningless, so the database refuses to store one.
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId   String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  // This index is what makes the DataLoader batch query fast: the batched
  // lookup is `WHERE taskId IN (...)`, and without an index on taskId that is
  // a full table scan no matter how well the requests are batched. Batching
  // and indexing solve different halves of the same problem.
  @@index([taskId])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Voice message feature.
//
// WHY THE AUDIO FILE IS NOT IN THIS TABLE
//
// Prisma could happily store a `Bytes` column and SQLite would accept it. It is
// still the wrong place, for reasons that compound as the app grows:
//
//   Backups. A database dump is normally text-ish and cheap to move. Fill it
//   with megabytes of audio and every backup, restore and replica sync drags
//   those bytes along — even when you only wanted the rows.
//
//   Working set. Databases keep hot pages in memory. Binary blobs interleaved
//   with the rows evict the data that queries actually filter and join on, so
//   the whole table gets slower to serve a field almost nobody selects.
//
//   Delivery. A file in object storage is served straight to the browser by a
//   CDN, with range requests and caching for free — exactly what an <audio>
//   element needs in order to seek. A blob in a row has to be pulled through
//   the database connection, through the API process, and back out again,
//   turning a static asset into application load.
//
//   Streaming. Row-level blobs must be read whole. Object storage streams by
//   design.
//
// So the file goes to storage and the DATABASE KEEPS THE REFERENCE: a URL plus
// the metadata you want to display or filter on without fetching the audio
// (duration, mime type, size, upload time). Rows stay small, queries stay fast,
// and the bytes live where bytes belong.
//
// The tradeoff to know about: these are now two systems that can disagree.
// Deleting a row does not delete the file, and a failed upload can leave a row
// pointing at nothing. See src/server/storage.ts.
// ---------------------------------------------------------------------------

model VoiceMessage {
  id         String   @id @default(cuid())
  url        String
  duration   Int?
  mimeType   String   @default("audio/webm")
  sizeBytes  Int?
  uploadedAt DateTime @default(now())

  // onDelete: Cascade so removing a task cannot leave an orphan row behind.
  // Note it does NOT remove the stored file — see the note above.
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String @unique
  // ^ @unique makes this 1-1: a task has at most one voice message.
  //   It is also what lets the resolver use a single `upsert` keyed on taskId.
}
